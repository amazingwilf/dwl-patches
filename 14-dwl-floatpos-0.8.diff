+void
+getfloatpos(int pos, char pch, int size, char sch, int minp, int maxs,
+		int cp, int cs, int defgrid, int *outp, int *outs)
+{
+	int absp = pch == 'A' || pch == 'a';
+	int abss = sch == 'A' || sch == 'a';
+	int delta, i, rest;
+
+	switch (pch) {
+	case 'A': /* absolute position */
+		cp = pos;
+		break;
+	case 'a': /* position relative to current position */
+		cp += pos;
+		break;
+	case 'x':
+	case 'y': /* client-relative position */
+		cp = MIN(cp + pos, minp + maxs);
+		break;
+	case 'X':
+	case 'Y': /* position relative to monitor */
+		cp = minp + MIN(pos, maxs);
+		break;
+	case 'S': /* fixed client position (sticky edge) */
+	case 'C': /* fixed client centre */
+	case 'Z': /* fixed far edge (position + size) */
+		if (pos == -1)
+			break;
+		pos = MAX(MIN(pos, maxs), 0);
+		if (pch == 'Z')
+			cs = abs((cp + cs) - (minp + pos));
+		else if (pch == 'C')
+			cs = abs((cp + cs / 2) - (minp + pos));
+		else
+			cs = abs(cp - (minp + pos));
+		cp = minp + pos;
+		sch = 0; /* size determined by position */
+		break;
+	case 'G': /* floating grid */
+		if (pos <= 0)
+			pos = defgrid;
+		if (size == 0 || pos < 2 || (sch != 'p' && sch != 'P'))
+			break;
+		delta = (maxs - cs) / (pos - 1);
+		rest = maxs - cs - delta * (pos - 1);
+		if (sch == 'P') {
+			if (size < 1 || size > pos)
+				break;
+			cp = minp + delta * (size - 1);
+		} else {
+			for (i = 0; i < pos && cp >= minp + delta * i
+					+ (i > pos - rest ? i + rest - pos + 1 : 0); i++);
+			cp = minp + delta * (MAX(MIN(i + size, pos), 1) - 1)
+					+ (i > pos - rest ? i + rest - pos + 1 : 0);
+		}
+		break;
+	}
+
+	switch (sch) {
+	case 'A': /* absolute size */
+		cs = size;
+		break;
+	case 'a': /* size relative to current size */
+		cs = MAX(1, cs + size);
+		break;
+	case '%': /* percentage of monitor window area */
+		if (size <= 0)
+			break;
+		size = maxs * MIN(size, 100) / 100;
+		/* fall through */
+	case 'h':
+	case 'w': /* size relative to client */
+		if (sch == 'w' || sch == 'h') {
+			if (size == 0)
+				break;
+			size += cs;
+		}
+		/* fall through */
+	case 'H':
+	case 'W': /* explicit size */
+		if (pch == 'S' && cp + size > minp + maxs)
+			size = minp + maxs - cp;
+		else if (size > maxs)
+			size = maxs;
+
+		if (pch == 'C') {
+			delta = size - cs;
+			if (delta < 0 || cp - delta / 2 + size <= minp + maxs)
+				cp -= delta / 2;
+			else if (cp - delta / 2 < minp)
+				cp = minp;
+			else if (delta)
+				cp = minp + maxs;
+		} else if (pch == 'Z')
+			cp -= size - cs;
+		cs = size;
+		break;
+	}
+
+	if (pch == '%') /* client midpoint as percentage of monitor area */
+		cp = minp + maxs * MAX(MIN(pos, 100), 0) / 100 - cs / 2;
+	if (pch == 'm' || pch == 'M')
+		cp = pos - cs / 2;
+
+	if (!absp && cp < minp)
+		cp = minp;
+	if (cp + cs > minp + maxs && !(absp && abss)) {
+		if (absp || cp == minp)
+			cs = minp + maxs - cp;
+		else
+			cp = minp + maxs - cs;
+	}
+
+	*outp = cp;
+	*outs = MAX(cs, 1);
+}
+
+void
+setfloatpos(Client *c, const char *floatpos)
+{
+	char xch, ych, wch = 0, hch = 0;
+	int x, y, w = 0, h = 0;
+	struct wlr_box geo;
+
+	if (!c || !c->mon || !floatpos || !c->isfloating)
+		return;
+
+	geo = c->geom;
+	switch (sscanf(floatpos, "%d%c %d%c %d%c %d%c",
+			&x, &xch, &y, &ych, &w, &wch, &h, &hch)) {
+	case 4:
+		if (xch == 'w' || xch == 'W') {
+			w = x; wch = xch;
+			h = y; hch = ych;
+			x = -1; xch = 'C';
+			y = -1; ych = 'C';
+		} else if (xch == 'p' || xch == 'P') {
+			w = x; wch = xch;
+			h = y; hch = ych;
+			x = 0; xch = 'G';
+			y = 0; ych = 'G';
+		} else if (xch == 'm' || xch == 'M') {
+			x = cursor->x;
+			y = cursor->y;
+		}
+		break;
+	case 8:
+		if (xch == 'm' || xch == 'M') {
+			x = cursor->x;
+			y = cursor->y;
+		}
+		break;
+	default:
+		return;
+	}
+
+	getfloatpos(x, xch, w, wch, c->mon->w.x, c->mon->w.width,
+			geo.x, geo.width, floatposgrid_x, &geo.x, &geo.width);
+	getfloatpos(y, ych, h, hch, c->mon->w.y, c->mon->w.height,
+			geo.y, geo.height, floatposgrid_y, &geo.y, &geo.height);
+
+	c->geom = geo;
+	if (client_surface(c)->mapped)
+		resize(c, geo, 0);
+}
