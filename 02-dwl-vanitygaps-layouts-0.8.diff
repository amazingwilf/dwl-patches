From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sun, 6 Sep 2026 13:58:00 +0100
Subject: [PATCH 3/3] vanitygaps: add DWM-style layout collection

Adds gap-aware variants of spiral, dwindle, deck, bottom stack,
bottom stack horizontal, columns, centered master, centered floating
master, grid, gapless grid and tatami.

This patch is intended to be applied after the two vanitygaps commits.
---
 config.def.h |  11 +++
 dwl.c        | 430 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 441 insertions(+)

diff --git a/config.def.h b/config.def.h
--- a/config.def.h
+++ b/config.def.h
@@ -28,6 +28,17 @@ static const Layout layouts[] = {
 	{ "[]=",      tile },
 	{ "><>",      NULL },    /* no layout function means floating behavior */
 	{ "[M]",      monocle },
+	{ "[@]",      spiral },
+	{ "[\\]",     dwindle },
+	{ "[D]",      deck },
+	{ "TTT",      bstack },
+	{ "===",      bstackhoriz },
+	{ "|||",      col },
+	{ "|M|",      centeredmaster },
+	{ ">M>",      centeredfloatingmaster },
+	{ "###",      grid },
+	{ ":::",      gaplessgrid },
+	{ "|+|",      tatami },
 };
 
 /* monitors */
diff --git a/dwl.c b/dwl.c
--- a/dwl.c
+++ b/dwl.c
@@ -271,5 +271,18 @@ static void createpopup(struct wl_listener *listener, void *data);
 static void cursorconstrain(struct wlr_pointer_constraint_v1 *constraint);
 static void cursorframe(struct wl_listener *listener, void *data);
 static void cursorwarptohint(void);
+static void bstack(Monitor *m);
+static void bstackhoriz(Monitor *m);
+static void centeredfloatingmaster(Monitor *m);
+static void centeredmaster(Monitor *m);
+static void col(Monitor *m);
+static void deck(Monitor *m);
+static void dwindle(Monitor *m);
+static void fibonacci(Monitor *m, int s);
+static void gaplessgrid(Monitor *m);
+static void getgaps(Monitor *m, int *oh, int *ov, int *ih, int *iv, unsigned int *n);
+static void grid(Monitor *m);
+static void spiral(Monitor *m);
+static void tatami(Monitor *m);
 static void defaultgaps(const Arg *arg);
 static void destroydecoration(struct wl_listener *listener, void *data);
@@ -1249,6 +1262,386 @@ cursorwarptohint(void)
 	}
 }
 
+void
+getgaps(Monitor *m, int *oh, int *ov, int *ih, int *iv, unsigned int *n)
+{
+	unsigned int oe = enablegaps, ie = enablegaps;
+	Client *c;
+
+	*n = 0;
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen)
+			(*n)++;
+
+	if (smartgaps && *n == 1)
+		oe = 0;
+
+	*oh = m->gappoh * oe;
+	*ov = m->gappov * oe;
+	*ih = m->gappih * ie;
+	*iv = m->gappiv * ie;
+}
+
+void
+bstack(Monitor *m)
+{
+	unsigned int i = 0, n, nm, ns;
+	int oh, ov, ih, iv, x, y, w, h, mh, sh;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n)
+		return;
+	nm = MIN(n, MAX(m->nmaster, 0));
+	ns = n - nm;
+	x = m->w.x + ov;
+	y = m->w.y + oh;
+	w = m->w.width - 2 * ov;
+	h = m->w.height - 2 * oh;
+	mh = (nm && ns) ? (int)roundf((h - ih) * m->mfact) : h;
+	sh = h - mh - (nm && ns ? ih : 0);
+
+	wl_list_for_each(c, &clients, link) {
+		unsigned int k, count;
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (i < nm) {
+			k = i; count = nm;
+			resize(c, (struct wlr_box){x + (int)k * (w + iv) / count, y,
+				(w - (int)(count - 1) * iv) / (int)count, mh}, 0);
+		} else {
+			k = i - nm; count = ns;
+			resize(c, (struct wlr_box){x + (int)k * (w + iv) / count,
+				y + mh + (nm ? ih : 0),
+				(w - (int)(count - 1) * iv) / (int)count, sh}, 0);
+		}
+		i++;
+	}
+}
+
+void
+bstackhoriz(Monitor *m)
+{
+	unsigned int i = 0, n, nm, ns;
+	int oh, ov, ih, iv, x, y, w, h, mh, sh;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n)
+		return;
+	nm = MIN(n, MAX(m->nmaster, 0));
+	ns = n - nm;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	mh = (nm && ns) ? (int)roundf((h - ih) * m->mfact) : h;
+	sh = h - mh - (nm && ns ? ih : 0);
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (i < nm) {
+			resize(c, (struct wlr_box){x + (int)i * (w + iv) / (int)nm, y,
+				(w - (int)(nm - 1) * iv) / (int)nm, mh}, 0);
+		} else {
+			unsigned int k = i - nm;
+			resize(c, (struct wlr_box){x,
+				y + mh + (nm ? ih : 0) + (int)k * (sh + ih) / (int)ns,
+				w, (sh - (int)(ns - 1) * ih) / (int)ns}, 0);
+		}
+		i++;
+	}
+}
+
+void
+col(Monitor *m)
+{
+	unsigned int i = 0, n, nm, ns;
+	int oh, ov, ih, iv, x, y, w, h, mw, sw;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n)
+		return;
+	nm = MIN(n, MAX(m->nmaster, 0));
+	ns = n - nm;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	mw = (nm && ns) ? (int)roundf((w - iv) * m->mfact) : w;
+	sw = w - mw - (nm && ns ? iv : 0);
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (i < nm) {
+			resize(c, (struct wlr_box){x + (int)i * (mw + iv) / (int)nm, y,
+				(mw - (int)(nm - 1) * iv) / (int)nm, h}, 0);
+		} else {
+			unsigned int k = i - nm;
+			resize(c, (struct wlr_box){x + mw + (nm ? iv : 0),
+				y + (int)k * (h + ih) / (int)ns, sw,
+				(h - (int)(ns - 1) * ih) / (int)ns}, 0);
+		}
+		i++;
+	}
+}
+
+void
+deck(Monitor *m)
+{
+	unsigned int i = 0, n, nm, ns;
+	int oh, ov, ih, iv, x, y, w, h, mw, sw;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n)
+		return;
+	nm = MIN(n, MAX(m->nmaster, 0));
+	ns = n - nm;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	mw = (nm && ns) ? (int)roundf((w - iv) * m->mfact) : w;
+	sw = w - mw - (nm && ns ? iv : 0);
+	if (ns)
+		snprintf(m->ltsymbol, LENGTH(m->ltsymbol), "D %u", ns);
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (i < nm)
+			resize(c, (struct wlr_box){x,
+				y + (int)i * (h + ih) / (int)nm, mw,
+				(h - (int)(nm - 1) * ih) / (int)nm}, 0);
+		else
+			resize(c, (struct wlr_box){x + mw + (nm ? iv : 0), y, sw, h}, 0);
+		i++;
+	}
+}
+
+void
+centeredmaster(Monitor *m)
+{
+	unsigned int i = 0, n, nm, ns, nl, nr;
+	int oh, ov, ih, iv, x, y, w, h, mw, sw, mx, lx, rx;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n)
+		return;
+	nm = MIN(n, MAX(m->nmaster, 0)); ns = n - nm;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	if (!ns) { mw = w; sw = 0; mx = x; }
+	else if (ns == 1) { mw = (int)roundf((w - iv) * m->mfact); sw = w - mw - iv; mx = x; }
+	else { mw = (int)roundf((w - 2 * iv) * m->mfact); sw = (w - mw - 2 * iv) / 2; mx = x + sw + iv; }
+	lx = x; rx = mx + mw + iv;
+	nl = (ns + 1) / 2; nr = ns / 2;
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		if (i < nm)
+			resize(c, (struct wlr_box){mx, y + (int)i * (h + ih) / (int)nm, mw,
+				(h - (int)(nm - 1) * ih) / (int)nm}, 0);
+		else if (((i - nm) % 2) == 0) {
+			unsigned int k = (i - nm) / 2;
+			int sx = ns == 1 ? mx + mw + iv : rx;
+			resize(c, (struct wlr_box){sx, y + (int)k * (h + ih) / (int)nl,
+				ns == 1 ? sw : sw, (h - (int)(nl - 1) * ih) / (int)nl}, 0);
+		} else {
+			unsigned int k = (i - nm) / 2;
+			resize(c, (struct wlr_box){lx, y + (int)k * (h + ih) / (int)nr, sw,
+				(h - (int)(nr - 1) * ih) / (int)nr}, 0);
+		}
+		i++;
+	}
+}
+
+void
+centeredfloatingmaster(Monitor *m)
+{
+	unsigned int i = 0, n, nm, ns;
+	int oh, ov, ih, iv, x, y, w, h, mw, mh, mx, my;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n) return;
+	nm = MIN(n, MAX(m->nmaster, 0)); ns = n - nm;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	if (!ns) { mw = w; mh = h; mx = x; my = y; }
+	else if (w > h) { mw = (int)roundf(w * m->mfact); mh = (int)roundf(h * 0.9); mx = x + (w - mw) / 2; my = y + (h - mh) / 2; }
+	else { mw = (int)roundf(w * 0.9); mh = (int)roundf(h * m->mfact); mx = x + (w - mw) / 2; my = y + (h - mh) / 2; }
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		if (i < nm)
+			resize(c, (struct wlr_box){mx + (int)i * (mw + iv) / (int)nm, my,
+				(mw - (int)(nm - 1) * iv) / (int)nm, mh}, 0);
+		else {
+			unsigned int k = i - nm;
+			resize(c, (struct wlr_box){x + (int)k * (w + iv) / (int)ns, y,
+				(w - (int)(ns - 1) * iv) / (int)ns, h}, 0);
+		}
+		i++;
+	}
+}
+
+void
+fibonacci(Monitor *m, int s)
+{
+	unsigned int i = 0, n;
+	int oh, ov, ih, iv, nx, ny, nw, nh;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n) return;
+	nx = m->w.x + ov; ny = m->w.y + oh;
+	nw = m->w.width - 2 * ov; nh = m->w.height - 2 * oh;
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		if ((i % 2 && nh / 2 > 1) || (!(i % 2) && nw / 2 > 1)) {
+			if (i < n - 1) {
+				if (i % 2) nh = (nh - ih) / 2; else nw = (nw - iv) / 2;
+				if ((i % 4) == 2 && !s) nx += nw + iv;
+				else if ((i % 4) == 3 && !s) ny += nh + ih;
+			}
+			if ((i % 4) == 0) { if (s) ny += nh + ih; else ny -= nh + ih; }
+			else if ((i % 4) == 1) nx += nw + iv;
+			else if ((i % 4) == 2) ny += nh + ih;
+			else if ((i % 4) == 3) { if (s) nx += nw + iv; else nx -= nw + iv; }
+			if (i == 0) { if (n != 1) nw = (int)roundf((m->w.width - 2 * ov - iv) * m->mfact); ny = m->w.y + oh; }
+			else if (i == 1) nw = m->w.width - nw - iv - 2 * ov;
+			i++;
+		}
+		resize(c, (struct wlr_box){nx, ny, nw, nh}, 0);
+	}
+}
+
+void
+dwindle(Monitor *m)
+{
+	fibonacci(m, 1);
+}
+
+void
+spiral(Monitor *m)
+{
+	fibonacci(m, 0);
+}
+
+void
+grid(Monitor *m)
+{
+	unsigned int i = 0, n, cols, rows;
+	int oh, ov, ih, iv, x, y, w, h;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n) return;
+	for (cols = 0; cols * cols < n; cols++);
+	rows = (n + cols - 1) / cols;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	wl_list_for_each(c, &clients, link) {
+		unsigned int coln, rown;
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		coln = i % cols; rown = i / cols;
+		resize(c, (struct wlr_box){x + (int)coln * (w + iv) / (int)cols,
+			y + (int)rown * (h + ih) / (int)rows,
+			(w - (int)(cols - 1) * iv) / (int)cols,
+			(h - (int)(rows - 1) * ih) / (int)rows}, 0);
+		i++;
+	}
+}
+
+void
+gaplessgrid(Monitor *m)
+{
+	unsigned int i = 0, n, cols, rows;
+	int oh, ov, ih, iv, x, y, w, h;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n) return;
+	for (cols = 0; cols <= n / 2; cols++) if (cols * cols >= n) break;
+	if (n == 5) cols = 2;
+	rows = n / cols;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	wl_list_for_each(c, &clients, link) {
+		unsigned int coln, rown, thisrows;
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		coln = i / rows; rown = i % rows;
+		if ((i / rows + 1) * rows > n) rows = n - i / rows * rows;
+		thisrows = rows;
+		resize(c, (struct wlr_box){x + (int)coln * (w + iv) / (int)cols,
+			y + (int)rown * (h + ih) / (int)thisrows,
+			(w - (int)(cols - 1) * iv) / (int)cols,
+			(h - (int)(thisrows - 1) * ih) / (int)thisrows}, 0);
+		i++;
+	}
+}
+
+void
+tatami(Monitor *m)
+{
+	unsigned int i = 0, n, mats, rem, idx = 0;
+	int oh, ov, ih, iv, x, y, w, h, mw, sx, sw, mh;
+	Client *c;
+
+	getgaps(m, &oh, &ov, &ih, &iv, &n);
+	if (!n) return;
+	x = m->w.x + ov; y = m->w.y + oh;
+	w = m->w.width - 2 * ov; h = m->w.height - 2 * oh;
+	mw = n == 1 ? w : (int)roundf((w - iv) * m->mfact);
+	sx = x + mw + (n > 1 ? iv : 0); sw = w - mw - (n > 1 ? iv : 0);
+
+	/* First tiled client is the master; the remaining clients are grouped
+	 * into mats of up to five, following the original tatami layout. */
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		if (idx++ == 0) { resize(c, (struct wlr_box){x, y, mw, h}, 0); break; }
+	}
+	if (n == 1) return;
+
+	rem = n - 1; mats = (rem + 4) / 5;
+	mh = (h - (int)(mats - 1) * ih) / (int)mats;
+	idx = 0;
+	wl_list_for_each(c, &clients, link) {
+		unsigned int mat, pos, count;
+		int bx, by, bw, bh, gx = iv, gy = ih;
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		if (i++ == 0) continue;
+		mat = idx / 5; pos = idx % 5;
+		count = MIN(5, rem - mat * 5);
+		bx = sx; by = y + (int)mat * (mh + ih); bw = sw; bh = mh;
+		if (count == 1) {
+			/* fill */
+		} else if (count == 2) {
+			bh = (mh - gy) / 2; if (pos) by += bh + gy;
+		} else if (count == 3) {
+			if (pos < 2) { bw = (sw - gx) / 2; bh = (2 * (mh - gy)) / 3; if (pos) bx += bw + gx; }
+			else { by += (2 * (mh - gy)) / 3 + gy; bh = mh - (2 * (mh - gy)) / 3 - gy; }
+		} else if (count == 4) {
+			int q = (mh - 2 * gy) / 4;
+			if (pos == 0) bh = q;
+			else if (pos == 1 || pos == 2) { bw = (sw - gx) / 2; by += q + gy; bh = 2 * q; if (pos == 2) bx += bw + gx; }
+			else { by += 3 * q + 2 * gy; bh = mh - 3 * q - 2 * gy; }
+		} else {
+			int cw = (sw - 2 * gx) / 3, ch = (mh - 2 * gy) / 3;
+			switch (pos) {
+			case 0: bw = cw; bh = 2 * ch + gy; break;
+			case 1: bx += cw + gx; bw = 2 * cw + gx; bh = ch; break;
+			case 2: bx += cw + gx; by += ch + gy; bw = cw; bh = ch; break;
+			case 3: bx += 2 * (cw + gx); by += ch + gy; bw = cw; bh = 2 * ch + gy; break;
+			case 4: by += 2 * (ch + gy); bw = 2 * cw + gx; bh = ch; break;
+			}
+		}
+		resize(c, (struct wlr_box){bx, by, MAX(1, bw), MAX(1, bh)}, 0);
+		idx++;
+	}
+}
