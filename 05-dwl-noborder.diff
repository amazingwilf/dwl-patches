diff --git a/dwl.c b/dwl.c
index 79cb9e7..3ea2cd4 100644
--- a/dwl.c
+++ b/dwl.c
@@ -585,14 +585,26 @@ void
 arrange(Monitor *m)
 {
 	Client *c;
+	unsigned int bw, n = 0;
 
 	if (!m->wlr_output->enabled)
 		return;
 
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m))
+			n++;
+
 	wl_list_for_each(c, &clients, link) {
 		if (c->mon == m) {
 			wlr_scene_node_set_enabled(&c->scene->node, VISIBLEON(c, m));
 			client_set_suspended(c, !VISIBLEON(c, m));
+			if (VISIBLEON(c, m)) {
+				bw = (!c->isfullscreen && (n != 1 || c->isfloating)) ? borderpx : 0;
+				if (c->bw != bw) {
+					c->bw = bw;
+					resize(c, c->geom, 0);
+				}
+			}
 		}
 	}
 
